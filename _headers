# Cloudflare static-asset headers. Supported identically by Workers (assets) and Pages; the
# site moved from the latter to the former on 2026-08-13 without changing this file.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self)

# The catalogue is regenerated occasionally — revalidate rather than cache hard, so a
# rebuild reaches users without a hash-busting rename.
/viewpoints.json
  Cache-Control: public, max-age=300, must-revalidate

# Pages serves clean URLs: /index.html and /map.html both 308-redirect to / and /map.
# A `/*.html` rule therefore only ever decorates the redirect, never the page it lands on —
# match the served paths instead. Five minutes is short enough that a deploy reaches people
# quickly, long enough that a back/forward navigation does not revalidate.
/
  Cache-Control: public, max-age=300, must-revalidate

/map
  Cache-Control: public, max-age=300, must-revalidate

/astronomy
  Cache-Control: public, max-age=300, must-revalidate

/methods
  Cache-Control: public, max-age=300, must-revalidate

