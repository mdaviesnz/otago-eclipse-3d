{
  // Static-asset Worker with a narrow `/api/*` script route.
  //
  // `assets.run_worker_first` is scoped to `["/api/*"]` so every static asset request (HTML,
  // CSS, viewpoints.json, icons) is served straight from the asset store at the edge without
  // invoking `src/worker.js` — keeping static traffic free and unmetered. Only `/api/*`
  // requests invoke the Worker script.
  "name": "otago-eclipse",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",

  "assets": {
    // Assembled by the deploy workflow. The file list lives in tests/check_static.py
    // (SITE_FILES) and is mirrored by the workflow's copy step.
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],

    // Both of these are the wrangler defaults, stated explicitly because _headers depends on
    // them:
    //
    //   auto-trailing-slash serves index.html at / and map.html at /map, and 308-redirects the
    //   .html paths to those — the same behaviour the _headers rules were written against, so
    //   the `/` and `/map` entries keep matching the paths users actually land on.
    //
    //   none returns a plain 404 for an unknown path. This is not an SPA; rewriting misses to
    //   index.html would serve the app with a broken URL instead of failing honestly.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // Cloudflare Workers Analytics Engine dataset for anonymous usage metrics (`/api/metric`).
  // Created automatically on first write; requires no separate provisioning step.
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "otago_eclipse_usage"
    }
  ]
}
